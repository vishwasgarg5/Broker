{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"broker/ohlcv/1.0.0",
 "title":"BROKER OHLCV record",
 "type":"object","additionalProperties":false,
 "required":["schema_version","date","symbol","exchange","asset_class","open","high","low","close","volume","source","retrieved_at"],
 "properties":{
  "schema_version":{"const":"1.0.0"},"date":{"type":"string","format":"date"},
  "symbol":{"type":"string","minLength":1},"exchange":{"enum":["NSE","BSE","MCX","AMFI","RBI"]},
  "asset_class":{"enum":["equity_cash","index","fo_reference","etf","mutual_fund","commodity","gsec","sgb"]},
  "open":{"type":"number","exclusiveMinimum":0},"high":{"type":"number","exclusiveMinimum":0},"low":{"type":"number","exclusiveMinimum":0},"close":{"type":"number","exclusiveMinimum":0},
  "volume":{"type":"number","minimum":0},"adj_close":{"type":["number","null"],"exclusiveMinimum":0},
  "source":{"type":"string","minLength":1},"retrieved_at":{"type":"string","format":"date-time"}
 }
}